# 이 파일을 .env 로 복사한 뒤 값을 채우세요.
#   cp .env.example .env
# .env 는 git에 올라가지 않습니다. API 키를 남에게 공유하지 마세요.

# ─────────────────────────────────────────────
# 필수
# ─────────────────────────────────────────────
# platform.openai.com 에서 발급 (본인 키를 쓰세요 — 사용료가 키 주인에게 청구됩니다)
OPENAI_API_KEY=sk-...

# ─────────────────────────────────────────────
# 모델 (품질 우선 설정)
# ─────────────────────────────────────────────
# 교정·전체정리본 등 핵심 텍스트 작업. 품질 차이가 가장 크게 나는 부분.
OPENAI_TEXT_MODEL=gpt-5.6-terra
# 핵심정리(요약). terra로 올리면 품질이 조금 오르지만 비용이 2.5배가 됩니다.
OPENAI_SUMMARY_MODEL=gpt-5.6-luna
# 가독성(문어체 변환). 위와 동일.
OPENAI_READABILITY_MODEL=gpt-5.6-luna
# 그림 위주 슬라이드 설명 생성
OPENAI_VISION_MODEL=gpt-4o-mini
# 페이지-스크립트 매칭 정확도에 직결. large 권장.
OPENAI_EMBEDDING_MODEL=text-embedding-3-large

# 전사본 업로드 기준 강의 1개당 대략:
#   요약·가독성을 luna 로  → 약 385원  (지금 설정)
#   요약·가독성을 terra 로 → 약 960원

# ─────────────────────────────────────────────
# 저장 위치
# ─────────────────────────────────────────────
JOB_STORAGE_DIR=./storage/jobs

# 배포 시 프론트 URL 추가 (쉼표 구분)
# CORS_ORIGINS=https://your-app.vercel.app,http://localhost:3010

# ─────────────────────────────────────────────
# 노션 자동 동기화 (선택 — notion_sync.py 를 쓸 때만)
# ─────────────────────────────────────────────
# 웹 화면으로만 쓸 거면 아래는 비워 두세요. 없어도 앱은 정상 동작합니다.
# NOTION_TOKEN=ntn_...
# NOTION_DATA_SOURCE_ID=
